 typedef struct
 {
     uint8_t job_id;
@@ -23,6 +53,8 @@ typedef struct
     uint32_t starting_nonce;
     uint8_t version_count;
     uint32_t rolled_versions[VIRTUAL_VERSION_COUNT];
+    uint32_t first_chunk_states[VIRTUAL_VERSION_COUNT][8];
+    uint32_t chunk1_words_be[VIRTUAL_VERSION_COUNT][16];
     bm_job job;
     char jobid[96];
 } virtual_job_snapshot_t;
@@ -49,6 +81,197 @@ static uint32_t increment_bitmask(uint32_t value, uint32_t mask)
     return new_value;
 }

+static uint32_t byteswap32(uint32_t value)
+{
+    return __builtin_bswap32(value);
+}
+
+static uint32_t rotate_right32(uint32_t value, uint8_t shift)
+{
+    return (value >> shift) | (value << (32 - shift));
+}
+
+static uint32_t load_be32(const uint8_t *data)
+{
+    return ((uint32_t) data[0] << 24)
+        | ((uint32_t) data[1] << 16)
+        | ((uint32_t) data[2] << 8)
+        | (uint32_t) data[3];
+}
+
+static void sha256_compress_words(uint32_t state[8], const uint32_t block_words[16])
+{
+    uint32_t w[64];
+    for (int i = 0; i < 16; i++) {
+        w[i] = block_words[i];
+    }
+    for (int i = 16; i < 64; i++) {
+        uint32_t s0 = rotate_right32(w[i - 15], 7) ^ rotate_right32(w[i - 15], 18) ^ (w[i - 15] >> 3);
+        uint32_t s1 = rotate_right32(w[i - 2], 17) ^ rotate_right32(w[i - 2], 19) ^ (w[i - 2] >> 10);
+        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+    }
+
+    uint32_t a = state[0];
+    uint32_t b = state[1];
+    uint32_t c = state[2];
+    uint32_t d = state[3];
+    uint32_t e = state[4];
+    uint32_t f = state[5];
+    uint32_t g = state[6];
+    uint32_t h = state[7];
+
+    for (int i = 0; i < 64; i++) {
+        uint32_t s1 = rotate_right32(e, 6) ^ rotate_right32(e, 11) ^ rotate_right32(e, 25);
+        uint32_t ch = (e & f) ^ ((~e) & g);
+        uint32_t temp1 = h + s1 + ch + SHA256_K[i] + w[i];
+        uint32_t s0 = rotate_right32(a, 2) ^ rotate_right32(a, 13) ^ rotate_right32(a, 22);
+        uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+        uint32_t temp2 = s0 + maj;
+
+        h = g;
+        g = f;
+        f = e;
+        e = d + temp1;
+        d = c;
+        c = b;
+        b = a;
+        a = temp1 + temp2;
+    }
+
+    state[0] += a;
+    state[1] += b;
+    state[2] += c;
+    state[3] += d;
+    state[4] += e;
+    state[5] += f;
+    state[6] += g;
+    state[7] += h;
+}
+
+static void sha256_compress(uint32_t state[8], const uint8_t block[64])
+{
+    uint32_t block_words[16];
+    for (int i = 0; i < 16; i++) {
+        block_words[i] = load_be32(block + (i * 4));
+    }
+    sha256_compress_words(state, block_words);
+}
+
+static void build_header_template(uint8_t header_template[BITCOIN_HEADER_TEMPLATE_SIZE], uint32_t rolled_version, const bm_job *source)
+{
+    memcpy(header_template, &rolled_version, sizeof(rolled_version));
+    memcpy(header_template + 4, source->prev_block_hash, 32);
+    memcpy(header_template + 36, source->merkle_root, 32);
+    memcpy(header_template + 68, &source->ntime, sizeof(source->ntime));
+    memcpy(header_template + 72, &source->target, sizeof(source->target));
+}
+
+static void prepare_virtual_work_cache(
+    uint32_t first_chunk_state[8],
+    uint32_t chunk1_words_be[16],
+    const bm_job *source,
+    uint32_t rolled_version
+)
+{
+    uint8_t header_template[BITCOIN_HEADER_TEMPLATE_SIZE];
+    uint8_t header_chunk0[64] = {};
+    uint8_t header_suffix[BITCOIN_HEADER_SUFFIX_SIZE] = {};
+
+    build_header_template(header_template, rolled_version, source);
+    memcpy(header_chunk0, header_template, sizeof(header_chunk0));
+    memcpy(header_suffix, header_template + 64, sizeof(header_suffix));
+
+    memcpy(first_chunk_state, SHA256_H0, sizeof(uint32_t) * 8);
+    sha256_compress(first_chunk_state, header_chunk0);
+
+    memset(chunk1_words_be, 0, sizeof(uint32_t) * 16);
+    for (int i = 0; i < 3; i++) {
+        chunk1_words_be[i] = load_be32(header_suffix + (i * 4));
+    }
+    chunk1_words_be[4] = 0x80000000;
+    chunk1_words_be[15] = 0x00000280;
+}
+
+static void double_sha256_header_hash_exact(
+    const uint32_t first_chunk_state[8],
+    const uint32_t chunk1_words_be[16],
+    uint32_t nonce,
+    uint8_t hash_result[32]
+)
+{
+    uint8_t first_hash[32];
+    uint8_t second_hash_block[64] = {};
+    uint32_t state[8];
+    uint32_t second_block_words[16];
+    uint32_t second_hash_state[8];
+
+    memcpy(state, first_chunk_state, sizeof(uint32_t) * 8);
+    memcpy(second_block_words, chunk1_words_be, sizeof(uint32_t) * 16);
+    second_block_words[3] = byteswap32(nonce);
+    sha256_compress_words(state, second_block_words);
+
+    for (int i = 0; i < 8; i++) {
+        uint32_t word = byteswap32(state[i]);
+        memcpy(first_hash + (i * 4), &word, sizeof(word));
+    }
+
+    memcpy(second_hash_block, first_hash, sizeof(first_hash));
+    second_hash_block[32] = 0x80;
+    second_hash_block[62] = 0x01;
+    second_hash_block[63] = 0x00;
+    memcpy(second_hash_state, SHA256_H0, sizeof(second_hash_state));
+    sha256_compress(second_hash_state, second_hash_block);
+
+    for (int i = 0; i < 8; i++) {
+        uint32_t word = byteswap32(second_hash_state[i]);
+        memcpy(hash_result + (i * 4), &word, sizeof(word));
+    }
+}
+
+static double virtual_hash_diff(const uint8_t hash_result[32])
+{
+    double value = le256todouble(hash_result);
+    if (value == 0.0) {
+        return TRUEDIFF_ONE;
+    }
+    return TRUEDIFF_ONE / value;
+}
+
+static bool virtual_hash_candidate_filter_accepts(const uint8_t hash_result[32], double pool_diff)
+{
+    if (pool_diff < 1.0) {
+        if (pool_diff >= (1.0 / 65536.0)) {
+            return hash_result[31] == 0 && hash_result[30] == 0;
+        }
+        if (pool_diff >= (1.0 / 16777216.0)) {
+            return hash_result[31] == 0;
+        }
+        return true;
+    }
+
+    return hash_result[28] == 0
+        && hash_result[29] == 0
+        && hash_result[30] == 0
+        && hash_result[31] == 0;
+}
+
+static bool virtual_job_candidate_diff_for_nonce(
+    const uint32_t first_chunk_state[8],
+    const uint32_t chunk1_words_be[16],
+    uint32_t nonce,
+    double pool_diff,
+    double *out_diff
+)
+{
+    uint8_t hash_result[32];
+    double_sha256_header_hash_exact(first_chunk_state, chunk1_words_be, nonce, hash_result);
+    if (!virtual_hash_candidate_filter_accepts(hash_result, pool_diff)) {
+        return false;
+    }
+    *out_diff = virtual_hash_diff(hash_result);
+    return true;
+}
+
 static void snapshot_job(virtual_job_snapshot_t *snapshot, uint8_t job_id, const bm_job *source)
 {
     memset(snapshot, 0, sizeof(*snapshot));
@@ -65,15 +288,26 @@ static void snapshot_job(virtual_job_snapshot_t *snapshot, uint8_t job_id, const

     snapshot->version_count = source->version_mask == 0 ? 1 : VIRTUAL_VERSION_COUNT;
     snapshot->rolled_versions[0] = source->version;
+    prepare_virtual_work_cache(snapshot->first_chunk_states[0], snapshot->chunk1_words_be[0], &snapshot->job, snapshot->rolled_versions[0]);
     for (uint8_t i = 1; i < snapshot->version_count; i++) {
         snapshot->rolled_versions[i] = increment_bitmask(snapshot->rolled_versions[i - 1], source->version_mask);
+        prepare_virtual_work_cache(snapshot->first_chunk_states[i], snapshot->chunk1_words_be[i], &snapshot->job, snapshot->rolled_versions[i]);
     }
 }

