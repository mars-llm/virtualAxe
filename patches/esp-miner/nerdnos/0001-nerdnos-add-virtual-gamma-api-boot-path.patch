+#include "virtualaxe_gamma.h"
+
+#include <algorithm>
+#include <math.h>
+
+VirtualAxeGamma::VirtualAxeGamma() : Board()
+{
+    m_deviceModel = "virtualAxe Gamma";
+    m_miningAgent = "virtualAxe-gamma";
+    m_version = 1;
+    m_asicModel = "BM1370";
+    m_asicCount = 1;
+    m_numTempSensors = 1;
+    m_numFans = 1;
+    m_fanLabels[0] = "Fan";
+
+    m_asicJobIntervalMs = 500;
+    m_asicFrequencies = {100, 125, 150, 175, 200};
+    m_asicVoltages = {1000, 1050, 1100, 1150, 1200};
+    m_defaultAsicFrequency = m_asicFrequency = 100;
+    m_defaultAsicVoltageMillis = m_asicVoltageMillis = 1000;
+    m_absMaxAsicFrequency = 200;
+    m_absMaxAsicVoltageMillis = 1200;
+
+    m_pidSettings[0].targetTemp = 60;
+    m_pidSettings[0].p = 600;
+    m_pidSettings[0].i = 10;
+    m_pidSettings[0].d = 1000;
+
+    m_maxPin = 15.0f;
+    m_minPin = 0.0f;
+    m_maxVin = 13.0f;
+    m_minVin = 11.0f;
+    m_minCurrentA = 0.0f;
+    m_maxCurrentA = 2.0f;
+    m_vr_maxTemp = 90.0f;
+
+    m_asicMaxDifficulty = 2048;
+    m_asicMinDifficulty = 1;
+    m_asicMinDifficultyDualPool = 1;
+    m_hasHashCounter = false;
+    m_defaultTheme = "default";
+}
+
+bool VirtualAxeGamma::initBoard()
+{
+    Board::initBoard();
+    setChipTemp(0, 42.0f);
+    m_isBuckInitialized = true;
+    return true;
+}
+
+bool VirtualAxeGamma::initAsics()
+{
+    return false;
+}
+
+bool VirtualAxeGamma::setAsicFrequency(float frequency)
+{
+    if (!validateFrequency(frequency)) {
+        return false;
+    }
+    m_asicFrequency = (int) frequency;
+    return true;
+}
+
+bool VirtualAxeGamma::setVoltage(float core_voltage)
+{
+    if (!validateVoltage(core_voltage)) {
+        return false;
+    }
+    m_vout = core_voltage;
+    return true;
+}
+
+void VirtualAxeGamma::setFanPolarity(bool invert)
+{
+    (void) invert;
+}
+
+void VirtualAxeGamma::setFanSpeedCh(int channel, float perc)
+{
+    if (channel != 0) {
+        return;
+    }
+    float clamped = std::max(0.0f, std::min(1.0f, perc));
+    m_fanPerc = clamped * 100.0f;
+    m_fanRpm = (uint16_t) roundf(1200.0f + 3600.0f * clamped);
+}
+
+void VirtualAxeGamma::getFanSpeedCh(int channel, uint16_t *rpm)
+{
+    if (!rpm) {
+        return;
+    }
+    *rpm = (channel == 0) ? m_fanRpm : 0;
+}
+
+float VirtualAxeGamma::getTemperature(int index)
+{
+    return index == 0 ? 42.0f : 0.0f;
+}
+
+float VirtualAxeGamma::getVRTemp()
+{
+    return 45.0f;
+}
+
+bool VirtualAxeGamma::isPIDAvailable()
+{
+    return true;
+}
+
+float VirtualAxeGamma::getVin()
+{
+    return m_vin;
+}
+
+float VirtualAxeGamma::getIin()
+{
+    return m_iin;
+}
+
+float VirtualAxeGamma::getPin()
+{
+    return m_vin * m_iin;
+}
+
+float VirtualAxeGamma::getVout()
+{
+    return m_vout;
+}
+
+float VirtualAxeGamma::getIout()
+{
+    return m_iout;
+}
+
+float VirtualAxeGamma::getPout()
+{
+    return m_vout * m_iout;
+}
+
+void VirtualAxeGamma::requestBuckTelemtry()
+{
+}
+
+void VirtualAxeGamma::requestChipTemps()
+{
+    setChipTemp(0, getTemperature(0));
+}
+
+float VirtualAxeGamma::getVRTempInt()
+{
+    return 44.0f;
+}
