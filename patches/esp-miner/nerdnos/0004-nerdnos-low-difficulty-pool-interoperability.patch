@@ -246,7 +248,21 @@ namespace Config {

     // ---- uint64_t Getters ----
     inline uint64_t getBestDiff() { return nvs_config_get_u64(NVS_CONFIG_BEST_DIFF, 0); }
-    inline uint32_t getStratumDifficulty() { return (uint32_t) nvs_config_get_u64(NVS_CONFIG_STRATUM_DIFFICULTY, CONFIG_STRATUM_DIFFICULTY); }
+    inline double parseStratumDifficulty(const char *key, uint64_t default_value) {
+        char *difficulty = nvs_config_get_string(key, "");
+        if (difficulty) {
+            char *end = nullptr;
+            double value = strtod(difficulty, &end);
+            bool parsed = end && *end == '\0' && value > 0;
+            free(difficulty);
+            if (parsed) {
+                return value;
+            }
+        }
+        return (double) nvs_config_get_u64(key, default_value);
+    }
+    inline double getStratumDifficulty() { return parseStratumDifficulty(NVS_CONFIG_STRATUM_DIFFICULTY, CONFIG_STRATUM_DIFFICULTY); }
+    inline double getStratumFallbackDifficulty() { return parseStratumDifficulty(NVS_CONFIG_STRATUM_FALLBACK_DIFFICULTY, CONFIG_STRATUM_DIFFICULTY); }
