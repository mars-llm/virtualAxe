diff --git a/components/bm1397/virtual_asic.cpp b/components/bm1397/virtual_asic.cpp
new file mode 100644
index 00000000..bc67f429
--- /dev/null
+++ b/components/bm1397/virtual_asic.cpp
@@ -0,0 +1,257 @@
+#include "virtual_asic.h"
+
+#include <limits.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "esp_log.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/queue.h"
+#include "freertos/task.h"
+#include "mining.h"
+
+static const char *TAG = "virtual_asic";
+static const uint32_t SEARCH_YIELD_INTERVAL = 0x3ff;
+static const UBaseType_t WORKER_TASK_PRIORITY = 4;
+static const uint8_t VIRTUAL_VERSION_COUNT = 4;
+static const uint8_t VIRTUAL_MAX_ASIC_JOBS = 128;
+
+typedef struct
+{
+    uint8_t job_id;
+    uint32_t generation_id;
+    uint32_t starting_nonce;
+    uint8_t version_count;
+    uint32_t rolled_versions[VIRTUAL_VERSION_COUNT];
+    bm_job job;
+    char jobid[96];
+} virtual_job_snapshot_t;
+
+static QueueHandle_t s_jobQueue = nullptr;
+static QueueHandle_t s_resultQueue = nullptr;
+static TaskHandle_t s_workerTask = nullptr;
+static task_result s_result;
+
+static uint32_t increment_bitmask(uint32_t value, uint32_t mask)
+{
+    if (mask == 0) {
+        return value;
+    }
+
+    uint32_t carry = (value & mask) + (mask & -mask);
+    uint32_t overflow = carry & ~mask;
+    uint32_t new_value = (value & ~mask) | (carry & mask);
+
+    if (overflow > 0) {
+        new_value = increment_bitmask(new_value, overflow << 1);
+    }
+
+    return new_value;
+}
+
+static void snapshot_job(virtual_job_snapshot_t *snapshot, uint8_t job_id, const bm_job *source)
+{
+    memset(snapshot, 0, sizeof(*snapshot));
+    snapshot->job_id = job_id;
+    snapshot->generation_id = source->generation_id;
+    snapshot->starting_nonce = source->starting_nonce;
+    memcpy(&snapshot->job, source, sizeof(snapshot->job));
+    snapshot->job.jobid = snapshot->jobid;
+    snapshot->job.extranonce2 = nullptr;
+
+    if (source->jobid) {
+        strncpy(snapshot->jobid, source->jobid, sizeof(snapshot->jobid) - 1);
+    }
+
+    snapshot->version_count = source->version_mask == 0 ? 1 : VIRTUAL_VERSION_COUNT;
+    snapshot->rolled_versions[0] = source->version;
+    for (uint8_t i = 1; i < snapshot->version_count; i++) {
+        snapshot->rolled_versions[i] = increment_bitmask(snapshot->rolled_versions[i - 1], source->version_mask);
+    }
+}
+
+static bool test_snapshot_nonce(const virtual_job_snapshot_t *snapshot, uint32_t nonce, uint32_t *rolled_version)
+{
+    for (uint8_t i = 0; i < snapshot->version_count; i++) {
+        double diff = test_nonce_value(&snapshot->job, nonce, snapshot->rolled_versions[i]);
+        if (diff >= snapshot->job.pool_diff) {
+            *rolled_version = snapshot->rolled_versions[i];
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool search_valid_nonce(const virtual_job_snapshot_t *snapshot, uint32_t *out_nonce, uint32_t *out_rolled_version)
+{
+    uint32_t nonce = snapshot->starting_nonce;
+    while (true) {
+        if (test_snapshot_nonce(snapshot, nonce, out_rolled_version)) {
+            *out_nonce = nonce;
+            return true;
+        }
+
+        if (nonce == UINT32_MAX) {
+            return false;
+        }
+
+        nonce++;
+        if ((nonce & SEARCH_YIELD_INTERVAL) == 0) {
+            if (uxQueueMessagesWaiting(s_jobQueue) > 0) {
+                return false;
+            }
+            vTaskDelay(1);
+        }
+    }
+}
+
+static void virtual_asic_worker(void *pvParameters)
+{
+    (void) pvParameters;
+
+    ESP_LOGI(TAG, "Virtual ASIC worker started");
+    virtual_job_snapshot_t snapshot;
+    while (true) {
+        if (xQueueReceive(s_jobQueue, &snapshot, portMAX_DELAY) != pdTRUE) {
+            continue;
+        }
+
+        ESP_LOGI(TAG, "Virtual ASIC received job %s diff %.6f", snapshot.jobid, snapshot.job.pool_diff);
+        while (true) {
+            uint32_t nonce = 0;
+            uint32_t rolled_version = snapshot.job.version;
+            if (!search_valid_nonce(&snapshot, &nonce, &rolled_version)) {
+                if (uxQueueMessagesWaiting(s_jobQueue) > 0) {
+                    break;
+                }
+                ESP_LOGW(TAG, "No valid nonce found for virtual job %s", snapshot.jobid);
+                break;
+            }
+
+            task_result found = {};
+            found.job_id = snapshot.job_id;
+            found.generation_id = snapshot.generation_id;
+            found.nonce = nonce;
+            found.rolled_version = rolled_version;
+            found.asic_nr = 0;
+            found.is_reg_resp = 0;
+
+            if (xQueueSend(s_resultQueue, &found, 0) != pdTRUE) {
+                task_result discarded = {};
+                xQueueReceive(s_resultQueue, &discarded, 0);
+                if (xQueueSend(s_resultQueue, &found, 0) != pdTRUE) {
+                    ESP_LOGW(TAG, "Virtual ASIC result queue full; nonce result not queued");
+                }
+            }
+
+            if (nonce == UINT32_MAX || uxQueueMessagesWaiting(s_jobQueue) > 0) {
+                break;
+            }
+            snapshot.starting_nonce = nonce + 1;
+        }
+    }
+}
+
+uint8_t VirtualAsic::allocateJobId()
+{
+    m_nextJobId = (uint8_t)((m_nextJobId + 4) % VIRTUAL_MAX_ASIC_JOBS);
+    return m_nextJobId;
+}
+
+uint32_t VirtualAsic::allocateGenerationId()
+{
+    m_nextGenerationId++;
+    if (m_nextGenerationId == 0) {
+        m_nextGenerationId++;
+    }
+    return m_nextGenerationId;
+}
+
+const uint8_t* VirtualAsic::getChipId()
+{
+    static const uint8_t chip_id[6] = {0x13, 0x68, 0x00, 0x00, 0x00, 0x00};
+    return chip_id;
+}
+
+uint8_t VirtualAsic::jobToAsicId(uint8_t job_id)
+{
+    return job_id;
+}
+
+uint8_t VirtualAsic::asicToJobId(uint8_t asic_id)
+{
+    return asic_id;
+}
+
+uint8_t VirtualAsic::nonceToAsicNr(uint32_t nonce)
+{
+    (void) nonce;
+    return 0;
+}
+
+const char* VirtualAsic::getName()
+{
+    return "Virtual BM1370";
+}
+
+uint8_t VirtualAsic::init(uint64_t frequency, uint16_t asic_count, uint32_t difficulty, uint32_t vrFrequency)
+{
+    (void) frequency;
+    (void) asic_count;
+    (void) vrFrequency;
+
+    setJobDifficultyMask(difficulty);
+    if (!s_jobQueue) {
+        s_jobQueue = xQueueCreate(1, sizeof(virtual_job_snapshot_t));
+    }
+    if (!s_resultQueue) {
+        s_resultQueue = xQueueCreate(8, sizeof(task_result));
+    }
+    if (!s_jobQueue || !s_resultQueue) {
+        ESP_LOGE(TAG, "Failed to create virtual ASIC queues");
+        return 0;
+    }
+    if (!s_workerTask) {
+        xTaskCreate(virtual_asic_worker, "virtual_asic", 8192, nullptr, WORKER_TASK_PRIORITY, &s_workerTask);
+    }
+    ESP_LOGI(TAG, "Virtual ASIC backend ready");
+    return 1;
+}
+
+uint8_t VirtualAsic::sendWork(uint32_t job_id, bm_job *next_bm_job)
+{
+    (void) job_id;
+
+    uint8_t virtual_job_id = allocateJobId();
+    next_bm_job->generation_id = allocateGenerationId();
+
+    virtual_job_snapshot_t snapshot;
+    snapshot_job(&snapshot, virtual_job_id, next_bm_job);
+    xQueueOverwrite(s_jobQueue, &snapshot);
+    return virtual_job_id;
+}
+
+bool VirtualAsic::processWork(task_result *result)
+{
+    if (!s_resultQueue || xQueueReceive(s_resultQueue, &s_result, 0) != pdTRUE) {
+        return false;
+    }
+
+    memcpy(result, &s_result, sizeof(*result));
+    return true;
+}
+
+void VirtualAsic::setJobDifficultyMask(int difficulty)
+{
+    m_asicDifficulty = difficulty;
+}
+
+uint16_t VirtualAsic::getSmallCoreCount()
+{
+    return 1;
+}
+
+uint32_t VirtualAsic::getDefaultVrFrequency()
+{
+    return 0;
+}
