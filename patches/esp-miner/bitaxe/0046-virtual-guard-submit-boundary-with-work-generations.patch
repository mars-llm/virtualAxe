-static double virtual_job_diff_for_nonce(
+static double virtual_hash_diff(const uint8_t hash_result[32])
+{
+    double value = le256todouble(hash_result);
+    if (value == 0.0) {
+        return TRUEDIFF_ONE;
+    }
+
+    return TRUEDIFF_ONE / value;
+}
+
+static bool virtual_hash_candidate_filter_accepts(const uint8_t hash_result[32], double pool_diff)
+{
+    if (pool_diff < 1.0) {
+        // For low-difficulty pools, exact-valid hashes remain below an expanded
+        // diff-1 target. These checks only reject hashes whose most significant
+        // bits cannot be below that target.
+        if (pool_diff >= (1.0 / 65536.0)) {
+            return hash_result[31] == 0
+                && hash_result[30] == 0;
+        }
+        if (pool_diff >= (1.0 / 16777216.0)) {
+            return hash_result[31] == 0;
+        }
+        return true;
+    }
+
+    // For diff >= 1, every exact-valid little-endian hash is below the
+    // diff-1 target, whose top 32 bits are zero.
+    return hash_result[28] == 0
+        && hash_result[29] == 0
+        && hash_result[30] == 0
+        && hash_result[31] == 0;
+}
+
+static double virtual_job_exact_diff_for_nonce(
     const uint32_t first_chunk_state[8],
     const uint32_t chunk1_words_be[16],
     uint32_t nonce
