+TEST_CASE("Virtual ASIC job ids are invalidated by upstream clean jobs", "[mining virtual_asic]")
+{
+    bool used_slots[128] = { 0 };
+    uint8_t job_id = 124;
+
+    for (uint16_t i = 0; i < 128; i++) {
+        job_id = VIRTUAL_ASIC_next_cleanable_job_id(job_id);
+        TEST_ASSERT_EQUAL_UINT8(0, job_id % 4);
+        used_slots[job_id] = true;
+    }
+
+    bool valid_jobs[128] = { 0 };
+    for (uint16_t i = 0; i < 128; i++) {
+        valid_jobs[i] = used_slots[i];
+    }
+
+    for (uint16_t i = 0; i < 128; i += 4) {
+        valid_jobs[i] = false;
+    }
+
+    for (uint16_t i = 0; i < 128; i++) {
+        if (used_slots[i]) {
+            TEST_ASSERT_FALSE_MESSAGE(valid_jobs[i], "clean_jobs left a virtual-submittable job slot valid");
+        }
+    }
+}
