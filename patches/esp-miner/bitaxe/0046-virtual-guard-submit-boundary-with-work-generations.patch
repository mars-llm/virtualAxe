+TEST_CASE("Virtual ASIC candidate filter has no false negatives for exact-valid nonces", "[mining virtual_asic]")
+{
+    mining_notify notify_message;
+    notify_message.prev_block_hash = "d02b10fc0d4711eae1a805af50a8a83312a2215e00017f2b0000000000000000";
+    notify_message.version = 0x20000004;
+    notify_message.target = 0x1705ae3a;
+    notify_message.ntime = 0x646ff1a9;
+
+    uint8_t merkle_root[32];
+    hex2bin("6d0359c451434605c52a5a9ce074340be47c2c63840731f9edf1db3f26b1cdd9", merkle_root, 32);
+
+    bm_job job = { 0 };
+    construct_bm_job(&notify_message, merkle_root, 0x1fffe000, 1000, &job);
+
+    static const uint32_t nonces[] = {
+        0x00000000,
+        0x00000001,
+        0x0000ffff,
+        0x00ffffff,
+        0x276E8947,
+    };
+    static const double thresholds[] = {
+        0.000000001,
+        0.001,
+        1.0,
+        18.0,
+    };
+
+    uint32_t exact_valid_cases = 0;
+    uint32_t rejected_low_diff_candidates = 0;
+    uint32_t rolled_version = job.version;
+    for (uint8_t version_index = 0; version_index < job.num_midstates; version_index++) {
+        for (size_t nonce_index = 0; nonce_index < (sizeof(nonces) / sizeof(nonces[0])); nonce_index++) {
+            uint32_t nonce = nonces[nonce_index];
+            double exact_diff = VIRTUAL_ASIC_test_nonce_value(&job, nonce, rolled_version);
+            if (exact_diff < 0.001 &&
+                !VIRTUAL_ASIC_test_filter_accepts(&job, nonce, rolled_version, 0.001)) {
+                rejected_low_diff_candidates++;
+            }
+            for (size_t threshold_index = 0; threshold_index < (sizeof(thresholds) / sizeof(thresholds[0])); threshold_index++) {
+                double pool_diff = thresholds[threshold_index];
+                if (exact_diff >= pool_diff) {
+                    exact_valid_cases++;
+                    TEST_ASSERT_TRUE_MESSAGE(
+                        VIRTUAL_ASIC_test_filter_accepts(&job, nonce, rolled_version, pool_diff),
+                        "candidate filter rejected an exact-valid nonce"
+                    );
+                }
+            }
+        }
+
+        if (version_index + 1 < job.num_midstates) {
+            rolled_version = increment_bitmask(rolled_version, job.version_mask);
+        }
+    }
+
+    TEST_ASSERT_GREATER_THAN_UINT32(0, exact_valid_cases);
+    TEST_ASSERT_GREATER_THAN_UINT32(0, rejected_low_diff_candidates);
+}
