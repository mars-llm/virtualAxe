+static uint32_t load_be32(const uint8_t * data)
 {
-    uint8_t header[BITCOIN_HEADER_SIZE];
-    uint8_t hash_result[32];
+    return ((uint32_t)data[0] << 24)
+        | ((uint32_t)data[1] << 16)
+        | ((uint32_t)data[2] << 8)
+        | (uint32_t)data[3];
+}
+
+static void sha256_compress(uint32_t state[8], const uint8_t block[64])
+{
+    uint32_t w[64];
+    for (int i = 0; i < 16; i++) {
+        w[i] = load_be32(block + (i * 4));
+    }
+    for (int i = 16; i < 64; i++) {
+        uint32_t s0 = RROT32(w[i - 15], 7) ^ RROT32(w[i - 15], 18) ^ (w[i - 15] >> 3);
+        uint32_t s1 = RROT32(w[i - 2], 17) ^ RROT32(w[i - 2], 19) ^ (w[i - 2] >> 10);
+        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+    }
+
+    uint32_t a = state[0];
+    uint32_t b = state[1];
+    uint32_t c = state[2];
+    uint32_t d = state[3];
+    uint32_t e = state[4];
+    uint32_t f = state[5];
+    uint32_t g = state[6];
+    uint32_t h = state[7];
+
+    for (int i = 0; i < 64; i++) {
+        uint32_t s1 = RROT32(e, 6) ^ RROT32(e, 11) ^ RROT32(e, 25);
+        uint32_t ch = (e & f) ^ ((~e) & g);
+        uint32_t temp1 = h + s1 + ch + SHA256_K[i] + w[i];
+        uint32_t s0 = RROT32(a, 2) ^ RROT32(a, 13) ^ RROT32(a, 22);
+        uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+        uint32_t temp2 = s0 + maj;
+
+        h = g;
+        g = f;
+        f = e;
+        e = d + temp1;
+        d = c;
+        c = b;
+        b = a;
+        a = temp1 + temp2;
+    }
+
+    state[0] += a;
+    state[1] += b;
+    state[2] += c;
+    state[3] += d;
+    state[4] += e;
+    state[5] += f;
+    state[6] += g;
+    state[7] += h;
+}
 
