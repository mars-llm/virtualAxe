+static void prepare_header_midstate(
+    uint32_t first_block_midstate[8],
+    uint8_t header_suffix[BITCOIN_HEADER_SUFFIX_SIZE],
+    const uint8_t header_template[BITCOIN_HEADER_TEMPLATE_SIZE]
+)
+{
+    memcpy(first_block_midstate, SHA256_H0, sizeof(uint32_t) * 8);
+    sha256_compress(first_block_midstate, header_template);
+    memcpy(header_suffix, header_template + 64, BITCOIN_HEADER_SUFFIX_SIZE);
+}
+
+static bool double_sha256_header_hash(
+    const uint32_t first_block_midstate[8],
+    const uint8_t header_suffix[BITCOIN_HEADER_SUFFIX_SIZE],
+    uint32_t nonce,
+    uint8_t hash_result[32]
+)
+{
+    uint8_t second_block[64] = {0};
+    uint8_t second_hash_block[64] = {0};
+    uint32_t state[8];
+    uint32_t second_hash_state[8];
+    uint8_t first_hash[32];
+
+    memcpy(state, first_block_midstate, sizeof(uint32_t) * 8);
+    memcpy(second_block, header_suffix, BITCOIN_HEADER_SUFFIX_SIZE);
+    memcpy(second_block + BITCOIN_HEADER_SUFFIX_SIZE, &nonce, sizeof(nonce));
+    second_block[16] = 0x80;
+    second_block[62] = 0x02;
+    second_block[63] = 0x80;
+    sha256_compress(state, second_block);
+
+    for (int i = 0; i < 8; i++) {
+        uint32_t word = BYTESWAP32(state[i]);
+        memcpy(first_hash + (i * 4), &word, sizeof(word));
+    }
+
+    memcpy(second_hash_block, first_hash, sizeof(first_hash));
+    second_hash_block[32] = 0x80;
+    second_hash_block[62] = 0x01;
+    second_hash_block[63] = 0x00;
+    memcpy(second_hash_state, SHA256_H0, sizeof(second_hash_state));
+    sha256_compress(second_hash_state, second_hash_block);
+
+    if ((second_hash_state[7] & 0xFFFF) != 0) {
+        return false;
+    }
+
+    for (int i = 0; i < 8; i++) {
+        uint32_t word = BYTESWAP32(second_hash_state[i]);
+        memcpy(hash_result + (i * 4), &word, sizeof(word));
+    }
+    return true;
+}
