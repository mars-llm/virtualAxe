 .../network-edit/network.edit.component.ts    |  40 ++-
 main/http_server/http_server.c                |  19 +-
 main/virtual_partitions.c                     | 304 ++++++++++++++++++
 5 files changed, 369 insertions(+), 19 deletions(-)
 create mode 100644 main/virtual_partitions.c

