diff --git a/main/virtual_partitions.c b/main/virtual_partitions.c
new file mode 100644
index 0000000..b83d84a
--- /dev/null
+++ b/main/virtual_partitions.c
@@ -0,0 +1,304 @@
+#include "sdkconfig.h"
+
+#ifdef CONFIG_BITAXE_VIRTUAL
+
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "esp_ota_ops.h"
+#include "esp_partition.h"
+
+#define VIRTUAL_PARTITION_ERASE_SIZE 0x1000
+#define VIRTUAL_PARTITION_ITERATOR_MAGIC 0x56505849u
+
+extern esp_flash_t * esp_flash_default_chip;
+
+extern esp_partition_iterator_t __real_esp_partition_find(esp_partition_type_t type,
+                                                          esp_partition_subtype_t subtype,
+                                                          const char * label);
+extern const esp_partition_t * __real_esp_partition_find_first(esp_partition_type_t type,
+                                                               esp_partition_subtype_t subtype,
+                                                               const char * label);
+extern const esp_partition_t * __real_esp_partition_get(esp_partition_iterator_t iterator);
+extern esp_partition_iterator_t __real_esp_partition_next(esp_partition_iterator_t iterator);
+extern void __real_esp_partition_iterator_release(esp_partition_iterator_t iterator);
+
+typedef struct {
+    uint32_t magic;
+    esp_partition_type_t type;
+    esp_partition_subtype_t subtype;
+    size_t index;
+    char label[17];
+} virtual_partition_iterator_t;
+
+static esp_partition_t s_virtual_partitions[] = {
+    {
+        .flash_chip = NULL,
+        .type = ESP_PARTITION_TYPE_DATA,
+        .subtype = ESP_PARTITION_SUBTYPE_DATA_NVS,
+        .address = 0x9000,
+        .size = 0x6000,
+        .erase_size = VIRTUAL_PARTITION_ERASE_SIZE,
+        .label = "nvs",
+    },
+    {
+        .flash_chip = NULL,
+        .type = ESP_PARTITION_TYPE_DATA,
+        .subtype = ESP_PARTITION_SUBTYPE_DATA_PHY,
+        .address = 0xf000,
+        .size = 0x1000,
+        .erase_size = VIRTUAL_PARTITION_ERASE_SIZE,
+        .label = "phy_init",
+    },
+    {
+        .flash_chip = NULL,
+        .type = ESP_PARTITION_TYPE_APP,
+        .subtype = ESP_PARTITION_SUBTYPE_APP_FACTORY,
+        .address = 0x10000,
+        .size = 0x400000,
+        .erase_size = VIRTUAL_PARTITION_ERASE_SIZE,
+        .label = "factory",
+    },
+    {
+        .flash_chip = NULL,
+        .type = ESP_PARTITION_TYPE_DATA,
+        .subtype = ESP_PARTITION_SUBTYPE_DATA_SPIFFS,
+        .address = 0x410000,
+        .size = 0x300000,
+        .erase_size = VIRTUAL_PARTITION_ERASE_SIZE,
+        .label = "www",
+    },
+    {
+        .flash_chip = NULL,
+        .type = ESP_PARTITION_TYPE_APP,
+        .subtype = ESP_PARTITION_SUBTYPE_APP_OTA_0,
+        .address = 0x710000,
+        .size = 0x400000,
+        .erase_size = VIRTUAL_PARTITION_ERASE_SIZE,
+        .label = "ota_0",
+    },
+    {
+        .flash_chip = NULL,
+        .type = ESP_PARTITION_TYPE_APP,
+        .subtype = ESP_PARTITION_SUBTYPE_APP_OTA_1,
+        .address = 0xb10000,
+        .size = 0x400000,
+        .erase_size = VIRTUAL_PARTITION_ERASE_SIZE,
+        .label = "ota_1",
+    },
+    {
+        .flash_chip = NULL,
+        .type = ESP_PARTITION_TYPE_DATA,
+        .subtype = ESP_PARTITION_SUBTYPE_DATA_OTA,
+        .address = 0xf10000,
+        .size = 0x2000,
+        .erase_size = VIRTUAL_PARTITION_ERASE_SIZE,
+        .label = "otadata",
+    },
+    {
+        .flash_chip = NULL,
+        .type = ESP_PARTITION_TYPE_DATA,
+        .subtype = ESP_PARTITION_SUBTYPE_DATA_COREDUMP,
+        .address = 0xf12000,
+        .size = 0x10000,
+        .erase_size = VIRTUAL_PARTITION_ERASE_SIZE,
+        .label = "coredump",
+    },
+};
+
+static void virtual_partitions_bind_flash_chip(void)
+{
+    static bool initialized = false;
+
+    if (initialized) {
+        return;
+    }
+
+    for (size_t i = 0; i < sizeof(s_virtual_partitions) / sizeof(s_virtual_partitions[0]); ++i) {
+        s_virtual_partitions[i].flash_chip = esp_flash_default_chip;
+    }
+
+    initialized = true;
+}
+
+static const esp_partition_t * virtual_partition_lookup(esp_partition_type_t type,
+                                                        esp_partition_subtype_t subtype,
+                                                        const char * label)
+{
+    for (size_t i = 0; i < sizeof(s_virtual_partitions) / sizeof(s_virtual_partitions[0]); ++i) {
+        const esp_partition_t * partition = &s_virtual_partitions[i];
+
+        if (type != ESP_PARTITION_TYPE_ANY && partition->type != type) {
+            continue;
+        }
+
+        if (subtype != ESP_PARTITION_SUBTYPE_ANY && partition->subtype != subtype) {
+            continue;
+        }
+
+        if (label != NULL && strcmp(label, partition->label) != 0) {
+            continue;
+        }
+
+        return partition;
+    }
+
+    return NULL;
+}
+
+static bool virtual_partition_matches(const esp_partition_t * partition,
+                                      esp_partition_type_t type,
+                                      esp_partition_subtype_t subtype,
+                                      const char * label)
+{
+    if (type != ESP_PARTITION_TYPE_ANY && partition->type != type) {
+        return false;
+    }
+
+    if (subtype != ESP_PARTITION_SUBTYPE_ANY && partition->subtype != subtype) {
+        return false;
+    }
+
+    if (label != NULL && strcmp(label, partition->label) != 0) {
+        return false;
+    }
+
+    return true;
+}
+
+static size_t virtual_partition_next_index(size_t start_index,
+                                           esp_partition_type_t type,
+                                           esp_partition_subtype_t subtype,
+                                           const char * label)
+{
+    for (size_t i = start_index; i < sizeof(s_virtual_partitions) / sizeof(s_virtual_partitions[0]); ++i) {
+        if (virtual_partition_matches(&s_virtual_partitions[i], type, subtype, label)) {
+            return i;
+        }
+    }
+
+    return sizeof(s_virtual_partitions) / sizeof(s_virtual_partitions[0]);
+}
+
+static bool virtual_partition_iterator_is_owned(esp_partition_iterator_t iterator)
+{
+    if (iterator == NULL) {
+        return false;
+    }
+
+    const virtual_partition_iterator_t * state = (const virtual_partition_iterator_t *) iterator;
+    return state->magic == VIRTUAL_PARTITION_ITERATOR_MAGIC;
+}
+
+static const char * virtual_partition_iterator_label(const virtual_partition_iterator_t * state)
+{
+    return state->label[0] != '\0' ? state->label : NULL;
+}
+
+static esp_partition_iterator_t virtual_partition_iterator_new(esp_partition_type_t type,
+                                                               esp_partition_subtype_t subtype,
+                                                               const char * label,
+                                                               size_t start_index)
+{
+    size_t index = virtual_partition_next_index(start_index, type, subtype, label);
+    if (index >= sizeof(s_virtual_partitions) / sizeof(s_virtual_partitions[0])) {
+        return NULL;
+    }
+
+    virtual_partition_iterator_t * state = calloc(1, sizeof(*state));
+    if (state == NULL) {
+        return NULL;
+    }
+
+    state->magic = VIRTUAL_PARTITION_ITERATOR_MAGIC;
+    state->type = type;
+    state->subtype = subtype;
+    state->index = index;
+    if (label != NULL) {
+        strncpy(state->label, label, sizeof(state->label) - 1);
+    }
+
+    return (esp_partition_iterator_t) state;
+}
+
+esp_partition_iterator_t __wrap_esp_partition_find(esp_partition_type_t type,
+                                                   esp_partition_subtype_t subtype,
+                                                   const char * label)
+{
+    virtual_partitions_bind_flash_chip();
+
+    esp_partition_iterator_t iterator = virtual_partition_iterator_new(type, subtype, label, 0);
+    if (iterator != NULL) {
+        return iterator;
+    }
+
+    return __real_esp_partition_find(type, subtype, label);
+}
+
+const esp_partition_t * __wrap_esp_partition_find_first(esp_partition_type_t type,
+                                                        esp_partition_subtype_t subtype,
+                                                        const char * label)
+{
+    virtual_partitions_bind_flash_chip();
+
+    const esp_partition_t * partition = virtual_partition_lookup(type, subtype, label);
+    if (partition != NULL) {
+        return partition;
+    }
+
+    return __real_esp_partition_find_first(type, subtype, label);
+}
+
+const esp_partition_t * __wrap_esp_partition_get(esp_partition_iterator_t iterator)
+{
+    if (virtual_partition_iterator_is_owned(iterator)) {
+        const virtual_partition_iterator_t * state = (const virtual_partition_iterator_t *) iterator;
+        return &s_virtual_partitions[state->index];
+    }
+
+    return __real_esp_partition_get(iterator);
+}
+
+esp_partition_iterator_t __wrap_esp_partition_next(esp_partition_iterator_t iterator)
+{
+    if (!virtual_partition_iterator_is_owned(iterator)) {
+        return __real_esp_partition_next(iterator);
+    }
+
+    virtual_partition_iterator_t * state = (virtual_partition_iterator_t *) iterator;
+    size_t next_index = virtual_partition_next_index(state->index + 1, state->type, state->subtype,
+                                                     virtual_partition_iterator_label(state));
+    if (next_index >= sizeof(s_virtual_partitions) / sizeof(s_virtual_partitions[0])) {
+        free(state);
+        return NULL;
+    }
+
+    state->index = next_index;
+    return iterator;
+}
+
+void __wrap_esp_partition_iterator_release(esp_partition_iterator_t iterator)
+{
+    if (virtual_partition_iterator_is_owned(iterator)) {
+        free(iterator);
+        return;
+    }
+
+    __real_esp_partition_iterator_release(iterator);
+}
+
+const esp_partition_t * __wrap_esp_ota_get_running_partition(void)
+{
+    virtual_partitions_bind_flash_chip();
+
+    const esp_partition_t * partition =
+        virtual_partition_lookup(ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_FACTORY, "factory");
+    if (partition != NULL) {
+        return partition;
+    }
+
+    return __real_esp_partition_find_first(ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_FACTORY, "factory");
+}
+
+#endif
