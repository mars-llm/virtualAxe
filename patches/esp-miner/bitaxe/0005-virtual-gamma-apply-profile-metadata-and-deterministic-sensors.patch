@@ -77,7 +51,10 @@ esp_err_t device_config_init(void * pvParameters)
 
     for (int i = 0 ; i < ARRAY_SIZE(default_asic_configs); i++) {
         if (strcasecmp(default_asic_configs[i].name, asic_model) == 0) {
