diff --git a/main/http_server/http_server.c b/main/http_server/http_server.c
index acf0659..0937ff5 100644
--- a/main/http_server/http_server.c
+++ b/main/http_server/http_server.c
@@ -971,6 +971,9 @@ static esp_err_t GET_system_info(httpd_req_t * req)
     }
 
     cJSON_AddNumberToObject(root, "uptimeSeconds", (esp_timer_get_time() - GLOBAL_STATE->SYSTEM_MODULE.start_time) / 1000000);
+    cJSON_AddStringToObject(root, "deviceModel", GLOBAL_STATE->DEVICE_CONFIG.family.name);
+    cJSON_AddNumberToObject(root, "asicCount", GLOBAL_STATE->DEVICE_CONFIG.family.asic_count);
+    cJSON_AddNumberToObject(root, "hashDomains", GLOBAL_STATE->DEVICE_CONFIG.family.asic.hash_domains);
     cJSON_AddNumberToObject(root, "smallCoreCount", GLOBAL_STATE->DEVICE_CONFIG.family.asic.small_core_count);
     cJSON_AddStringToObject(root, "ASICModel", GLOBAL_STATE->DEVICE_CONFIG.family.asic.name);
     cJSON_AddStringToObject(root, "stratumURL", stratumURL);
@@ -1004,8 +1007,24 @@ static esp_err_t GET_system_info(httpd_req_t * req)
     cJSON_AddStringToObject(root, "networkType", connect_get_network_type());
 #ifdef CONFIG_BITAXE_VIRTUAL
     cJSON_AddStringToObject(root, "virtualAsicMode", VIRTUAL_ASIC_mode_string());
+    cJSON *virtual_workers = cJSON_CreateArray();
+    cJSON_AddItemToObject(root, "virtualAsicWorkers", virtual_workers);
+    for (uint8_t worker_index = 0; worker_index < VIRTUAL_ASIC_worker_count(); worker_index++) {
+        virtual_asic_worker_status_t worker_status;
+        if (!VIRTUAL_ASIC_get_worker_status(worker_index, &worker_status)) {
+            continue;
+        }
+
+        cJSON *worker = cJSON_CreateObject();
+        cJSON_AddItemToArray(virtual_workers, worker);
+        cJSON_AddNumberToObject(worker, "asicNr", worker_status.asic_nr);
+        cJSON_AddNumberToObject(worker, "laneOffset", worker_status.lane_offset);
+        cJSON_AddNumberToObject(worker, "laneStride", worker_status.lane_stride);
+        cJSON_AddNumberToObject(worker, "jobsAssigned", worker_status.jobs_assigned);
+    }
 #else
     cJSON_AddStringToObject(root, "virtualAsicMode", "");
+    cJSON_AddItemToObject(root, "virtualAsicWorkers", cJSON_CreateArray());
 #endif
 
     cJSON_AddStringToObject(root, "idfVersion", esp_get_idf_version());
diff --git a/main/thermal/thermal.c b/main/thermal/thermal.c
index 0d1db41..d866c52 100644
--- a/main/thermal/thermal.c
+++ b/main/thermal/thermal.c
@@ -10,10 +10,56 @@
 
 static const char * TAG = "thermal";
 
+#ifdef CONFIG_BITAXE_VIRTUAL
+static float virtual_fan_percent = 100.0f;
+static uint16_t virtual_fan_rpm = 3600;
+static uint16_t virtual_fan2_rpm = 0;
+static float virtual_chip_temp = 40.0f;
+static float virtual_chip_temp2 = 0.0f;
+
+static float clamp_float(float value, float min_value, float max_value)
+{
+    if (value < min_value) {
+        return min_value;
+    }
+    if (value > max_value) {
+        return max_value;
+    }
+    return value;
+}
+
+static void update_virtual_thermal_state(const GlobalState * GLOBAL_STATE)
+{
+    float frequency = GLOBAL_STATE->POWER_MANAGEMENT_MODULE.actual_frequency;
+    if (frequency <= 0.0f) {
+        frequency = GLOBAL_STATE->POWER_MANAGEMENT_MODULE.frequency_value;
+    }
+    if (frequency <= 0.0f) {
+        frequency = GLOBAL_STATE->DEVICE_CONFIG.family.asic.default_frequency_mhz;
+    }
+
+    float core_voltage_mv = GLOBAL_STATE->POWER_MANAGEMENT_MODULE.core_voltage;
+    if (core_voltage_mv <= 0.0f) {
+        core_voltage_mv = GLOBAL_STATE->DEVICE_CONFIG.family.asic.default_voltage_mv;
+    }
+
+    float cooling = clamp_float(virtual_fan_percent, 0.0f, 100.0f) * 0.08f;
+    float workload_heat = 34.0f + ((frequency - 300.0f) / 50.0f) * 1.2f + ((core_voltage_mv - 1000.0f) / 100.0f) * 1.5f;
+    virtual_chip_temp = clamp_float(workload_heat - cooling, 32.0f, 95.0f);
+    virtual_chip_temp2 = GLOBAL_STATE->DEVICE_CONFIG.family.asic_count > 1 ? clamp_float(virtual_chip_temp + 1.5f, 33.0f, 97.0f) : 0.0f;
+    virtual_fan_rpm = virtual_fan_percent > 0.0f ? (uint16_t)(1200.0f + (virtual_fan_percent * 24.0f)) : 0;
+    virtual_fan2_rpm = GLOBAL_STATE->DEVICE_CONFIG.family.asic_count > 1 ? virtual_fan_rpm : 0;
+}
+#endif
+
 esp_err_t Thermal_init(DeviceConfig * DEVICE_CONFIG)
 {
 #ifdef CONFIG_BITAXE_VIRTUAL
-    (void)DEVICE_CONFIG;
+    virtual_fan_percent = 100.0f;
+    virtual_fan_rpm = 3600;
+    virtual_fan2_rpm = DEVICE_CONFIG->family.asic_count > 1 ? virtual_fan_rpm : 0;
+    virtual_chip_temp = 40.0f;
+    virtual_chip_temp2 = DEVICE_CONFIG->family.asic_count > 1 ? 41.5f : 0.0f;
     return ESP_OK;
 #endif
 
@@ -44,7 +90,9 @@ esp_err_t Thermal_set_fan_percent(DeviceConfig * DEVICE_CONFIG, float percent)
 {
 #ifdef CONFIG_BITAXE_VIRTUAL
     (void)DEVICE_CONFIG;
-    (void)percent;
+    virtual_fan_percent = clamp_float(percent * 100.0f, 0.0f, 100.0f);
+    virtual_fan_rpm = virtual_fan_percent > 0.0f ? (uint16_t)(1200.0f + (virtual_fan_percent * 24.0f)) : 0;
+    virtual_fan2_rpm = DEVICE_CONFIG->family.asic_count > 1 ? virtual_fan_rpm : 0;
     return ESP_OK;
 #endif
 
@@ -64,7 +112,7 @@ uint16_t Thermal_get_fan_speed(DeviceConfig * DEVICE_CONFIG)
 {
 #ifdef CONFIG_BITAXE_VIRTUAL
     (void)DEVICE_CONFIG;
-    return 0;
+    return virtual_fan_rpm;
 #endif
 
     if (DEVICE_CONFIG->EMC2101) {
@@ -82,8 +130,7 @@ uint16_t Thermal_get_fan_speed(DeviceConfig * DEVICE_CONFIG)
 uint16_t Thermal_get_fan2_speed(DeviceConfig * DEVICE_CONFIG) 
 {
 #ifdef CONFIG_BITAXE_VIRTUAL
-    (void)DEVICE_CONFIG;
-    return 0;
+    return DEVICE_CONFIG->family.asic_count > 1 ? virtual_fan2_rpm : 0;
 #endif
 
     if (DEVICE_CONFIG->EMC2302) {
@@ -95,8 +142,8 @@ uint16_t Thermal_get_fan2_speed(DeviceConfig * DEVICE_CONFIG)
 float Thermal_get_chip_temp(GlobalState * GLOBAL_STATE)
 {
 #ifdef CONFIG_BITAXE_VIRTUAL
-    (void)GLOBAL_STATE;
-    return 40.0f;
+    update_virtual_thermal_state(GLOBAL_STATE);
+    return virtual_chip_temp;
 #endif
 
     if (!GLOBAL_STATE->ASIC_initalized) {
@@ -122,8 +169,8 @@ float Thermal_get_chip_temp(GlobalState * GLOBAL_STATE)
 float Thermal_get_chip_temp2(GlobalState * GLOBAL_STATE)
 {
 #ifdef CONFIG_BITAXE_VIRTUAL
-    (void)GLOBAL_STATE;
-    return 0.0f;
+    update_virtual_thermal_state(GLOBAL_STATE);
+    return GLOBAL_STATE->DEVICE_CONFIG.family.asic_count > 1 ? virtual_chip_temp2 : 0.0f;
 #endif
 
     if (!GLOBAL_STATE->ASIC_initalized) {
