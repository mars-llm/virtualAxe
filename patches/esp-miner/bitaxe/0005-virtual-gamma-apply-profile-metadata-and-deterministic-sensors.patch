From 87dc3cf3b6f8bc64fa35cc99529e996b95ff94ac Mon Sep 17 00:00:00 2001
From: virtualAxe <virtualaxe@example.invalid>
Date: Wed, 6 May 2026 12:37:20 +0200
Subject: [PATCH 05/13] virtual gamma: apply profile metadata and sensors

Why: make the virtual firmware report the configured Gamma profile and stable
virtual sensor values expected by AxeOS and API clients.
Virtual-only: virtual ASIC worker metadata and deterministic thermal values are
active only for CONFIG_BITAXE_VIRTUAL builds.
Upstream surface: device configuration, virtual ASIC status, HTTP system info,
and thermal readings.
Verify: run API system-info tests, browser/dashboard smoke, and make build.
Removal impact: AxeOS and API consumers no longer see a Gamma-shaped virtual
device with stable telemetry.

---
 components/asic/include/virtual_asic.h | 10 ++++
 components/asic/virtual_asic.c         | 21 +++++++++
 main/device_config.c                   | 48 ++++++++-----------
 main/http_server/http_server.c         | 19 ++++++++
 main/thermal/thermal.c                 | 65 ++++++++++++++++++++++----
 5 files changed, 125 insertions(+), 38 deletions(-)

diff --git a/components/asic/include/virtual_asic.h b/components/asic/include/virtual_asic.h
index 5246f45..eca1e9a 100644
--- a/components/asic/include/virtual_asic.h
+++ b/components/asic/include/virtual_asic.h
@@ -4,6 +4,14 @@
 #include "asic_common.h"
 #include "global_state.h"
 
+typedef struct
+{
+    uint8_t asic_nr;
+    uint8_t lane_offset;
+    uint8_t lane_stride;
+    uint32_t jobs_assigned;
+} virtual_asic_worker_status_t;
+
 uint8_t VIRTUAL_ASIC_init(GlobalState * GLOBAL_STATE);
 task_result * VIRTUAL_ASIC_process_work(GlobalState * GLOBAL_STATE);
 int VIRTUAL_ASIC_set_max_baud(void);
@@ -13,5 +21,7 @@ void VIRTUAL_ASIC_set_frequency(GlobalState * GLOBAL_STATE);
 double VIRTUAL_ASIC_get_job_frequency_ms(GlobalState * GLOBAL_STATE);
 void VIRTUAL_ASIC_read_registers(void);
 const char * VIRTUAL_ASIC_mode_string(void);
+uint8_t VIRTUAL_ASIC_worker_count(void);
+bool VIRTUAL_ASIC_get_worker_status(uint8_t index, virtual_asic_worker_status_t * out_status);
 
 #endif /* VIRTUAL_ASIC_H_ */
diff --git a/components/asic/virtual_asic.c b/components/asic/virtual_asic.c
index 038e9e3..9822dfa 100644
--- a/components/asic/virtual_asic.c
+++ b/components/asic/virtual_asic.c
@@ -38,6 +38,7 @@ static QueueHandle_t job_queue = NULL;
 static QueueHandle_t result_queue = NULL;
 static TaskHandle_t worker_task_handle = NULL;
 static task_result result;
+static uint32_t jobs_assigned = 0;
 static uint8_t next_job_id = 0;
 static portMUX_TYPE hash_counter_lock = portMUX_INITIALIZER_UNLOCKED;
 static uint32_t hash_attempt_counter = 0;
@@ -211,6 +212,7 @@ uint8_t VIRTUAL_ASIC_init(GlobalState * GLOBAL_STATE)
     if (worker_task_handle == NULL) {
         xTaskCreatePinnedToCore(virtual_asic_worker, "virtual_asic", 8192, NULL, WORKER_TASK_PRIORITY, &worker_task_handle, WORKER_TASK_CORE);
     }
+    jobs_assigned = 0;
     taskENTER_CRITICAL(&hash_counter_lock);
     hash_attempt_counter = 0;
     taskEXIT_CRITICAL(&hash_counter_lock);
@@ -255,6 +257,7 @@ void VIRTUAL_ASIC_send_work(GlobalState * GLOBAL_STATE, void * next_job)
     pthread_mutex_unlock(&GLOBAL_STATE->valid_jobs_lock);
 
     virtual_job_snapshot_t snapshot;
+    jobs_assigned++;
     copy_job_snapshot(&snapshot, next_job_id, next_bm_job);
     xQueueOverwrite(job_queue, &snapshot);
 }
@@ -295,3 +298,21 @@ const char * VIRTUAL_ASIC_mode_string(void)
 {
     return "cpu";
 }
+
+uint8_t VIRTUAL_ASIC_worker_count(void)
+{
+    return 1;
+}
+
+bool VIRTUAL_ASIC_get_worker_status(uint8_t index, virtual_asic_worker_status_t * out_status)
+{
+    if (out_status == NULL || index > 0) {
+        return false;
+    }
+
+    out_status->asic_nr = 0;
+    out_status->lane_offset = 0;
+    out_status->lane_stride = 1;
+    out_status->jobs_assigned = jobs_assigned;
+    return true;
+}
