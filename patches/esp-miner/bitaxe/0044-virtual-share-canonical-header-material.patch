 ///////cgminer nonce testing
+void bm_job_build_header80(const bm_job *job, const uint32_t rolled_version, const uint32_t nonce, uint8_t out_header[static BTC_HEADER_SIZE])
+{
+    memcpy(out_header, &rolled_version, sizeof(rolled_version));
+    reverse_32bit_words(job->prev_block_hash, out_header + 4);
+    reverse_32bit_words(job->merkle_root, out_header + 36);
+    memcpy(out_header + 68, &job->ntime, sizeof(job->ntime));
+    memcpy(out_header + 72, &job->target, sizeof(job->target));
+    memcpy(out_header + 76, &nonce, sizeof(nonce));
+}
+
+void bm_job_build_sha_material(
+    const bm_job *job,
+    const uint32_t rolled_version,
+    const uint32_t nonce,
+    btc_header_material_t *out_material
+)
+{
+    memset(out_material, 0, sizeof(*out_material));
+    bm_job_build_header80(job, rolled_version, nonce, out_material->header80);
+
+    memcpy(out_material->chunk0, out_material->header80, BTC_HEADER_CHUNK_SIZE);
+    memcpy(out_material->chunk1, out_material->header80 + BTC_HEADER_CHUNK_SIZE, BTC_HEADER_SIZE - BTC_HEADER_CHUNK_SIZE);
+    out_material->chunk1[16] = 0x80;
+    out_material->chunk1[62] = 0x02;
+    out_material->chunk1[63] = 0x80;
+
+    for (int i = 0; i < 16; i++) {
+        out_material->chunk1_be[i] = load_be32(out_material->chunk1 + (i * 4));
+    }
+}
