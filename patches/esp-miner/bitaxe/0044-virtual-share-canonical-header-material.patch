+TEST_CASE("Build canonical header material for software and virtual mining", "[mining]")
+{
+    mining_notify notify_message;
+    notify_message.prev_block_hash = "d02b10fc0d4711eae1a805af50a8a83312a2215e00017f2b0000000000000000";
+    notify_message.version = 0x20000004;
+    notify_message.target = 0x1705ae3a;
+    notify_message.ntime = 0x646ff1a9;
+
+    uint8_t merkle_root[32];
+    hex2bin("6d0359c451434605c52a5a9ce074340be47c2c63840731f9edf1db3f26b1cdd9", merkle_root, 32);
+
+    bm_job job = { 0 };
+    construct_bm_job(&notify_message, merkle_root, 0, 1000, &job);
+
+    uint32_t nonce = 0x276E8947;
+    uint32_t rolled_version = job.version;
+    uint8_t header80[80];
+    btc_header_material_t material;
+
+    bm_job_build_header80(&job, rolled_version, nonce, header80);
+    bm_job_build_sha_material(&job, rolled_version, nonce, &material);
+
+    TEST_ASSERT_EQUAL_UINT8_ARRAY(header80, material.header80, sizeof(material.header80));
+    TEST_ASSERT_EQUAL_UINT8_ARRAY(header80, material.chunk0, sizeof(material.chunk0));
+    TEST_ASSERT_EQUAL_UINT8_ARRAY(header80 + 64, material.chunk1, 16);
+    TEST_ASSERT_EQUAL_HEX8(0x80, material.chunk1[16]);
+    TEST_ASSERT_EQUAL_HEX8(0x02, material.chunk1[62]);
+    TEST_ASSERT_EQUAL_HEX8(0x80, material.chunk1[63]);
+    for (int i = 17; i < 62; i++) {
+        TEST_ASSERT_EQUAL_HEX8(0x00, material.chunk1[i]);
+    }
+
+    for (int i = 0; i < 16; i++) {
+        TEST_ASSERT_EQUAL_HEX32(test_load_be32(material.chunk1 + (i * 4)), material.chunk1_be[i]);
+    }
