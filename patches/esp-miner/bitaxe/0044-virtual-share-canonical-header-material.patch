+enum {
+    BTC_HEADER_SIZE = 80,
+    BTC_HEADER_CHUNK_SIZE = 64,
+};
+
+static uint32_t load_be32(const uint8_t *data)
+{
+    return ((uint32_t)data[0] << 24)
+        | ((uint32_t)data[1] << 16)
+        | ((uint32_t)data[2] << 8)
+        | (uint32_t)data[3];
+}
+
