+#ifdef CONFIG_BITAXE_VIRTUAL
+static void virtual_event_handler(void * arg, esp_event_base_t event_base, int32_t event_id, void * event_data)
+{
+    GlobalState * GLOBAL_STATE = (GlobalState *)arg;
+
+    if (event_base == ETH_EVENT) {
+        if (event_id == ETHERNET_EVENT_CONNECTED) {
+            strcpy(GLOBAL_STATE->SYSTEM_MODULE.wifi_status, "Link up");
+            GLOBAL_STATE->SYSTEM_MODULE.ap_enabled = false;
+            if (primary_netif != NULL) {
+                esp_netif_create_ip6_linklocal(primary_netif);
+            }
+        } else if (event_id == ETHERNET_EVENT_DISCONNECTED) {
+            GLOBAL_STATE->SYSTEM_MODULE.is_connected = false;
+            strcpy(GLOBAL_STATE->SYSTEM_MODULE.wifi_status, "Link down");
+            strcpy(GLOBAL_STATE->SYSTEM_MODULE.ip_addr_str, "");
+            strcpy(GLOBAL_STATE->SYSTEM_MODULE.ipv6_addr_str, "");
+        }
+    }
+
+    if (event_base == IP_EVENT && event_id == IP_EVENT_ETH_GOT_IP) {
+        ip_event_got_ip_t * event = (ip_event_got_ip_t *) event_data;
+        snprintf(GLOBAL_STATE->SYSTEM_MODULE.ip_addr_str, IP4ADDR_STRLEN_MAX, IPSTR, IP2STR(&event->ip_info.ip));
+        GLOBAL_STATE->SYSTEM_MODULE.is_connected = true;
+        strcpy(GLOBAL_STATE->SYSTEM_MODULE.wifi_status, "Connected!");
+    }
+
+    if (event_base == IP_EVENT && event_id == IP_EVENT_GOT_IP6) {
+        ip_event_got_ip6_t * event = (ip_event_got_ip6_t *) event_data;
+        inet_ntop(AF_INET6, &event->ip6_info.ip, GLOBAL_STATE->SYSTEM_MODULE.ipv6_addr_str, sizeof(GLOBAL_STATE->SYSTEM_MODULE.ipv6_addr_str));
+    }
+}
+
+static esp_err_t init_virtual_openeth(GlobalState * GLOBAL_STATE)
+{
+    ESP_ERROR_CHECK(esp_netif_init());
+
+    esp_err_t event_loop_ret = esp_event_loop_create_default();
+    if (event_loop_ret != ESP_OK && event_loop_ret != ESP_ERR_INVALID_STATE) {
+        ESP_ERROR_CHECK(event_loop_ret);
+    }
+
+    esp_netif_config_t netif_cfg = ESP_NETIF_DEFAULT_ETH();
+    primary_netif = esp_netif_new(&netif_cfg);
+    if (primary_netif == NULL) {
+        return ESP_ERR_NO_MEM;
+    }
+
+    char * hostname = nvs_config_get_string(NVS_CONFIG_HOSTNAME);
+    if (hostname != NULL) {
+        esp_netif_set_hostname(primary_netif, hostname);
+        free(hostname);
+    }
+
+    esp_event_handler_register(ETH_EVENT, ESP_EVENT_ANY_ID, &virtual_event_handler, GLOBAL_STATE);
+    esp_event_handler_register(IP_EVENT, IP_EVENT_ETH_GOT_IP, &virtual_event_handler, GLOBAL_STATE);
+    esp_event_handler_register(IP_EVENT, IP_EVENT_GOT_IP6, &virtual_event_handler, GLOBAL_STATE);
+
+    eth_mac_config_t mac_config = ETH_MAC_DEFAULT_CONFIG();
+    eth_phy_config_t phy_config = ETH_PHY_DEFAULT_CONFIG();
+    phy_config.autonego_timeout_ms = 100;
+
+    esp_eth_mac_t * mac = esp_eth_mac_new_openeth(&mac_config);
+    esp_eth_phy_t * phy = esp_eth_phy_new_dp83848(&phy_config);
+    if (mac == NULL || phy == NULL) {
+        return ESP_FAIL;
+    }
+
+    esp_eth_config_t config = ETH_DEFAULT_CONFIG(mac, phy);
+    ESP_ERROR_CHECK(esp_eth_driver_install(&config, &eth_handle));
+    ESP_ERROR_CHECK(esp_eth_ioctl(eth_handle, ETH_CMD_S_MAC_ADDR, (void *)virtual_mac));
+
+    esp_eth_netif_glue_handle_t glue = esp_eth_new_netif_glue(eth_handle);
+    ESP_ERROR_CHECK(esp_netif_attach(primary_netif, glue));
+
+    strcpy(GLOBAL_STATE->SYSTEM_MODULE.wifi_status, "Starting OpenETH...");
+    return esp_eth_start(eth_handle);
+}
+#endif
+
