diff --git a/components/asic/virtual_asic.c b/components/asic/virtual_asic.c
new file mode 100644
index 0000000..ef10ade
--- /dev/null
+++ b/components/asic/virtual_asic.c
@@ -0,0 +1,248 @@
+#include <inttypes.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/queue.h"
+#include "freertos/task.h"
+
+#include "mining.h"
+#include "virtual_asic.h"
+
+typedef struct
+{
+    uint8_t job_id;
+    uint32_t version;
+    uint32_t version_mask;
+    uint8_t prev_block_hash[32];
+    uint8_t merkle_root[32];
+    uint32_t ntime;
+    uint32_t target;
+    uint32_t starting_nonce;
+    double pool_diff;
+    char jobid[96];
+} virtual_job_snapshot_t;
+
+static const char * TAG = "virtual_asic";
+
+static QueueHandle_t job_queue = NULL;
+static QueueHandle_t result_queue = NULL;
+static TaskHandle_t worker_task_handle = NULL;
+static task_result result;
+static uint8_t next_job_id = 0;
+static portMUX_TYPE hash_counter_lock = portMUX_INITIALIZER_UNLOCKED;
+static uint32_t hash_attempt_counter = 0;
+
+static void virtual_record_hash_attempts(uint32_t attempts)
+{
+    if (attempts == 0) {
+        return;
+    }
+
+    taskENTER_CRITICAL(&hash_counter_lock);
+    hash_attempt_counter += attempts;
+    taskEXIT_CRITICAL(&hash_counter_lock);
+}
+
+static uint32_t virtual_hash_attempt_count(void)
+{
+    taskENTER_CRITICAL(&hash_counter_lock);
+    uint32_t value = hash_attempt_counter;
+    taskEXIT_CRITICAL(&hash_counter_lock);
+    return value;
+}
+
+static bool virtual_job_test_nonce(const virtual_job_snapshot_t * snapshot, uint32_t nonce, uint32_t * rolled_version, uint32_t * attempts)
+{
+    bm_job job = {0};
+    job.version = snapshot->version;
+    job.version_mask = snapshot->version_mask;
+    memcpy(job.prev_block_hash, snapshot->prev_block_hash, sizeof(job.prev_block_hash));
+    memcpy(job.merkle_root, snapshot->merkle_root, sizeof(job.merkle_root));
+    job.ntime = snapshot->ntime;
+    job.target = snapshot->target;
+    job.pool_diff = snapshot->pool_diff;
+
+    (*attempts)++;
+    *rolled_version = snapshot->version;
+    return test_nonce_value(&job, nonce, *rolled_version) >= snapshot->pool_diff;
+}
+
+static bool search_valid_nonce(const virtual_job_snapshot_t * snapshot, uint32_t * out_nonce, uint32_t * rolled_version)
+{
+    uint32_t nonce = snapshot->starting_nonce;
+    uint32_t attempts_since_flush = 0;
+    while (true) {
+        if (virtual_job_test_nonce(snapshot, nonce, rolled_version, &attempts_since_flush)) {
+            *out_nonce = nonce;
+            virtual_record_hash_attempts(attempts_since_flush);
+            return true;
+        }
+
+        if (nonce == UINT32_MAX) {
+            virtual_record_hash_attempts(attempts_since_flush);
+            return false;
+        }
+
+        nonce++;
+        if ((nonce & 0xFFFF) == 0) {
+            virtual_record_hash_attempts(attempts_since_flush);
+            attempts_since_flush = 0;
+            vTaskDelay(1 / portTICK_PERIOD_MS);
+        }
+    }
+}
+
+static void virtual_asic_worker(void * pvParameters)
+{
+    (void)pvParameters;
+
+    virtual_job_snapshot_t snapshot;
+    while (1) {
+        if (xQueueReceive(job_queue, &snapshot, portMAX_DELAY) != pdTRUE) {
+            continue;
+        }
+
+        uint32_t nonce = 0;
+        uint32_t rolled_version = snapshot.version;
+        if (!search_valid_nonce(&snapshot, &nonce, &rolled_version)) {
+            ESP_LOGW(TAG, "No valid nonce found for virtual job %s", snapshot.jobid);
+            continue;
+        }
+
+        task_result found = {
+            .job_id = snapshot.job_id,
+            .nonce = nonce,
+            .rolled_version = rolled_version,
+            .register_type = REGISTER_INVALID,
+            .asic_nr = 0,
+            .core_id = 0,
+            .small_core_id = 0,
+            .timestamp_us = esp_timer_get_time(),
+        };
+
+        if (xQueueSend(result_queue, &found, 0) != pdTRUE) {
+            task_result discarded;
+            xQueueReceive(result_queue, &discarded, 0);
+            xQueueSend(result_queue, &found, 0);
+        }
+    }
+}
+
+static void copy_job_snapshot(virtual_job_snapshot_t * snapshot, uint8_t job_id, const bm_job * source)
+{
+    memset(snapshot, 0, sizeof(*snapshot));
+    snapshot->job_id = job_id;
+    snapshot->version = source->version;
+    snapshot->version_mask = source->version_mask;
+    snapshot->ntime = source->ntime;
+    snapshot->target = source->target;
+    snapshot->starting_nonce = source->starting_nonce;
+    snapshot->pool_diff = source->pool_diff;
+    memcpy(snapshot->prev_block_hash, source->prev_block_hash, sizeof(snapshot->prev_block_hash));
+    memcpy(snapshot->merkle_root, source->merkle_root, sizeof(snapshot->merkle_root));
+    if (source->jobid != NULL) {
+        strncpy(snapshot->jobid, source->jobid, sizeof(snapshot->jobid) - 1);
+    }
+}
+
+uint8_t VIRTUAL_ASIC_init(GlobalState * GLOBAL_STATE)
+{
+    (void)GLOBAL_STATE;
+
+    if (job_queue == NULL) {
+        job_queue = xQueueCreate(1, sizeof(virtual_job_snapshot_t));
+    }
+    if (result_queue == NULL) {
+        result_queue = xQueueCreate(8, sizeof(task_result));
+    }
+    if (worker_task_handle == NULL) {
+        xTaskCreate(virtual_asic_worker, "virtual_asic", 8192, NULL, 8, &worker_task_handle);
+    }
+    taskENTER_CRITICAL(&hash_counter_lock);
+    hash_attempt_counter = 0;
+    taskEXIT_CRITICAL(&hash_counter_lock);
+
+    ESP_LOGI(TAG, "Virtual ASIC backend ready (%s mode)", VIRTUAL_ASIC_mode_string());
+    return 1;
+}
+
+task_result * VIRTUAL_ASIC_process_work(GlobalState * GLOBAL_STATE)
+{
+    (void)GLOBAL_STATE;
+
+    if (result_queue == NULL) {
+        return NULL;
+    }
+
+    if (xQueueReceive(result_queue, &result, 0) != pdTRUE) {
+        return NULL;
+    }
+
+    return &result;
+}
+
+int VIRTUAL_ASIC_set_max_baud(void)
+{
+    return 115200;
+}
+
+void VIRTUAL_ASIC_send_work(GlobalState * GLOBAL_STATE, void * next_job)
+{
+    bm_job * next_bm_job = (bm_job *)next_job;
+    next_job_id = (uint8_t)((next_job_id + 1) % 128);
+
+    if (GLOBAL_STATE->ASIC_TASK_MODULE.active_jobs[next_job_id] != NULL) {
+        free_bm_job(GLOBAL_STATE->ASIC_TASK_MODULE.active_jobs[next_job_id]);
+    }
+
+    GLOBAL_STATE->ASIC_TASK_MODULE.active_jobs[next_job_id] = next_bm_job;
+
+    pthread_mutex_lock(&GLOBAL_STATE->valid_jobs_lock);
+    GLOBAL_STATE->valid_jobs[next_job_id] = 1;
+    pthread_mutex_unlock(&GLOBAL_STATE->valid_jobs_lock);
+
+    virtual_job_snapshot_t snapshot;
+    copy_job_snapshot(&snapshot, next_job_id, next_bm_job);
+    xQueueOverwrite(job_queue, &snapshot);
+}
+
+void VIRTUAL_ASIC_set_version_mask(uint32_t mask)
+{
+    ESP_LOGI(TAG, "Ignoring virtual version mask update: %08" PRIx32, mask);
+}
+
+void VIRTUAL_ASIC_set_frequency(GlobalState * GLOBAL_STATE)
+{
+    GLOBAL_STATE->POWER_MANAGEMENT_MODULE.actual_frequency = GLOBAL_STATE->POWER_MANAGEMENT_MODULE.frequency_value;
+}
+
+double VIRTUAL_ASIC_get_job_frequency_ms(GlobalState * GLOBAL_STATE)
+{
+    (void)GLOBAL_STATE;
+
+    return 1000.0;
+}
+
+void VIRTUAL_ASIC_read_registers(void)
+{
+    if (result_queue == NULL) {
+        return;
+    }
+
+    task_result sample = {
+        .register_type = REGISTER_TOTAL_COUNT,
+        .asic_nr = 0,
+        .value = virtual_hash_attempt_count(),
+        .timestamp_us = esp_timer_get_time(),
+    };
+    xQueueSend(result_queue, &sample, 0);
+}
+
+const char * VIRTUAL_ASIC_mode_string(void)
+{
+    return "cpu";
+}
