+static void update_raw_hash_counter(measurement_t * measurement, uint32_t value, uint64_t time_us)
+{
+    uint64_t previous_time_us = measurement->time_us;
+    if (previous_time_us != 0) {
+        uint64_t duration_us = time_us - previous_time_us;
+        uint32_t counter = value - measurement->value;
+        if (duration_us != 0) {
+            float seconds = duration_us / 1000000.0f;
+            measurement->hashrate = (counter / seconds) / 1e9f;
+        }
+    }
+
+    measurement->value = value;
+    measurement->time_us = time_us;
+}
