-int STRATUM_V1_subscribe(esp_transport_handle_t transport, int send_uid, const char * model)
+#ifdef CONFIG_BITAXE_VIRTUAL
+static bool subscribe_agent_is_usable(const char *subscribe_agent)
+{
+    if (subscribe_agent == NULL || subscribe_agent[0] == '\0') {
+        return false;
+    }
+
+    for (const unsigned char *p = (const unsigned char *)subscribe_agent; *p != '\0'; p++) {
+        if (*p < 0x20 || *p == '"' || *p == '\\') {
+            return false;
+        }
+    }
+    return true;
+}
+#endif
+
+int STRATUM_V1_subscribe(esp_transport_handle_t transport, int send_uid, const char * model, const char * subscribe_agent)
 {
     // Subscribe
     char subscribe_msg[BUFFER_SIZE];
     const esp_app_desc_t *app_desc = esp_app_get_description();
     const char *version = app_desc->version;	
+
+#ifdef CONFIG_BITAXE_VIRTUAL
+    if (subscribe_agent_is_usable(subscribe_agent)) {
+        snprintf(subscribe_msg, sizeof(subscribe_msg),
+            "{\"id\":%d,\"method\":\"mining.subscribe\",\"params\":[\"%s\"]}\n",
+            send_uid, subscribe_agent);
+    } else {
+        if (subscribe_agent != NULL && subscribe_agent[0] != '\0') {
+            ESP_LOGW(TAG, "Ignoring unsafe mining.subscribe agent override");
+        }
+        snprintf(subscribe_msg, sizeof(subscribe_msg),
+            "{\"id\":%d,\"method\":\"mining.subscribe\",\"params\":[\"bitaxe/%s/%s\"]}\n",
+            send_uid, model, version);
+    }
+#else
+    (void)subscribe_agent;
     snprintf(subscribe_msg, sizeof(subscribe_msg),
         "{\"id\":%d,\"method\":\"mining.subscribe\",\"params\":[\"bitaxe/%s/%s\"]}\n",
         send_uid, model, version);
+#endif
     debug_stratum_tx(subscribe_msg);
 
     return esp_transport_write(transport, subscribe_msg, strlen(subscribe_msg), TRANSPORT_TIMEOUT_MS);
 }
 
