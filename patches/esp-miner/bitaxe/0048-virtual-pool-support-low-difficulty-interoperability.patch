 static RequestTiming request_timings[MAX_REQUEST_IDS];
 
+#ifdef CONFIG_BITAXE_VIRTUAL
+static void debug_stratum_rx(const char *stratum_json)
+{
+    if (strstr(stratum_json, "\"method\":\"mining.notify\"") ||
+        strstr(stratum_json, "\"method\": \"mining.notify\"")) {
+        ESP_LOGI(TAG, "rx: mining.notify (%u bytes)", (unsigned)strlen(stratum_json));
+        return;
+    }
+    ESP_LOGI(TAG, "rx: %s", stratum_json);
+}
+#else
+static void debug_stratum_rx(const char *stratum_json)
+{
+    ESP_LOGI(TAG, "rx: %s", stratum_json);
+}
+#endif
+
+#ifdef CONFIG_BITAXE_VIRTUAL
+#define VIRTUAL_SUBMIT_RESPONSE_TIMEOUT_US (15LL * 1000 * 1000)
+
+static bool submit_response_timeout_enabled = false;
+static bool submit_response_timeout_pending = false;
+
+void STRATUM_V1_reset_request_timings(void)
+{
+    for (int i = 0; i < MAX_REQUEST_IDS; i++) {
+        request_timings[i].timestamp_us = 0;
+        request_timings[i].tracking = false;
+    }
+    submit_response_timeout_pending = false;
+}
+
+void STRATUM_V1_set_submit_response_timeout_enabled(bool enabled)
+{
+    submit_response_timeout_enabled = enabled;
+    if (!enabled) {
+        submit_response_timeout_pending = false;
+    }
+}
+
+static bool submit_response_stalled(int64_t now_us)
+{
+    if (!submit_response_timeout_enabled) {
+        return false;
+    }
+
+    for (int i = 0; i < MAX_REQUEST_IDS; i++) {
+        if (request_timings[i].tracking &&
+            request_timings[i].timestamp_us > 0 &&
+            now_us - request_timings[i].timestamp_us >= VIRTUAL_SUBMIT_RESPONSE_TIMEOUT_US) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool STRATUM_V1_submit_response_stalled(void)
+{
+    bool stalled = submit_response_stalled(esp_timer_get_time());
+    if (stalled) {
+        submit_response_timeout_pending = true;
+    }
+    return stalled;
+}
+
+bool STRATUM_V1_consume_submit_response_timeout(void)
+{
+    bool pending = submit_response_timeout_pending;
+    submit_response_timeout_pending = false;
+    return pending;
+}
+#endif
+
 static RequestTiming* get_request_timing(int request_id) {
     if (request_id < 0) return NULL;
     int index = request_id % MAX_REQUEST_IDS;
@@ -175,6 +248,14 @@ char * STRATUM_V1_receive_jsonrpc_line(esp_transport_handle_t transport)
