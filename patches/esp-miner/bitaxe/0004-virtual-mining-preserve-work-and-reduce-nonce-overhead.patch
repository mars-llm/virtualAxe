+static bool use_periodic_work_refresh(const GlobalState *GLOBAL_STATE)
+{
+    return GLOBAL_STATE->DEVICE_CONFIG.family.asic.id != ASIC_VIRTUAL;
+}
+
+static void update_virtual_active_job_difficulty(GlobalState *GLOBAL_STATE, double difficulty)
+{
+    pthread_mutex_lock(&GLOBAL_STATE->valid_jobs_lock);
+    for (int i = 0; i < 128; i++) {
+        if (!GLOBAL_STATE->valid_jobs[i]) {
+            continue;
+        }
+
+        bm_job *active_job = GLOBAL_STATE->ASIC_TASK_MODULE.active_jobs[i];
+        if (active_job != NULL) {
+            active_job->pool_diff = difficulty;
+        }
+    }
+    pthread_mutex_unlock(&GLOBAL_STATE->valid_jobs_lock);
+}
