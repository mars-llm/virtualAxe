From 6a0f02af64ef2b05daf174e12df53ed3ee163497 Mon Sep 17 00:00:00 2001
From: virtualAxe <virtualaxe@example.invalid>
Date: Wed, 6 May 2026 12:37:21 +0200
Subject: [PATCH 07/13] virtual api: handle qemu patch and static responses

Why: keep AxeOS PATCH requests, static file responses, and runtime settings
sync reliable while the QEMU firmware is under mining load.
Virtual-only: runtime settings sync is guarded for CONFIG_BITAXE_VIRTUAL; the
HTTP buffer fixes preserve existing API behavior.
Upstream surface: HTTP static responses, PATCH body handling, and system runtime
state synchronization.
Verify: run API settings tests, persistence checks, and make verify-submit-replay.
Removal impact: settings updates can stall or desynchronize while AxeOS is used
against the virtual firmware.

---
 main/http_server/http_server.c | 29 ++++++++++++++++++++++++-----
 main/system.c                  | 28 ++++++++++++++++++++++++++--
 main/system.h                  |  1 +
 3 files changed, 51 insertions(+), 7 deletions(-)

diff --git a/main/http_server/http_server.c b/main/http_server/http_server.c
index 0937ff5..ca50295 100644
--- a/main/http_server/http_server.c
+++ b/main/http_server/http_server.c
@@ -485,8 +485,16 @@ static esp_err_t rest_common_get_handler(httpd_req_t * req)
         httpd_resp_set_hdr(req, "Content-Encoding", "gzip");
     }
 
-    char * chunk = rest_context->scratch;
+    char * chunk = malloc(SCRATCH_BUFSIZE);
+    if (chunk == NULL) {
+        close(fd);
+        ESP_LOGE(TAG, "Failed to allocate static file buffer");
+        httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "Failed to allocate file buffer");
+        return ESP_OK;
+    }
+
     ssize_t read_bytes;
+    esp_err_t send_result = ESP_OK;
     do {
         /* Read file in chunks into the scratch buffer */
         read_bytes = read(fd, chunk, SCRATCH_BUFSIZE);
@@ -496,6 +504,7 @@ static esp_err_t rest_common_get_handler(httpd_req_t * req)
             /* Send the buffer contents as HTTP response chunk */
             if (httpd_resp_send_chunk(req, chunk, read_bytes) != ESP_OK) {
                 close(fd);
+                free(chunk);
                 ESP_LOGE(TAG, "File sending failed!");
                 /* Abort sending file */
                 httpd_resp_sendstr_chunk(req, NULL);
@@ -507,10 +516,11 @@ static esp_err_t rest_common_get_handler(httpd_req_t * req)
     } while (read_bytes > 0);
     /* Close file after sending complete */
     close(fd);
+    free(chunk);
     ESP_LOGI(TAG, "File sending complete");
     /* Respond with an empty chunk to signal HTTP response completion */
-    httpd_resp_send_chunk(req, NULL, 0);
-    return ESP_OK;
+    send_result = httpd_resp_send_chunk(req, NULL, 0);
+    return send_result;
 }
 
 static esp_err_t handle_options_request(httpd_req_t * req)
@@ -658,16 +668,24 @@ static esp_err_t PATCH_update_settings(httpd_req_t * req)
 
     int total_len = req->content_len;
     int cur_len = 0;
-    char * buf = ((rest_server_context_t *) (req->user_ctx))->scratch;
+    char * buf = NULL;
     int received = 0;
     if (total_len >= SCRATCH_BUFSIZE) {
         /* Respond with 500 Internal Server Error */
         httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "content too long");
         return ESP_OK;
     }
+
+    buf = malloc(total_len + 1);
+    if (buf == NULL) {
+        httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "Memory allocation failed");
+        return ESP_OK;
+    }
+
     while (cur_len < total_len) {
-        received = httpd_req_recv(req, buf + cur_len, total_len);
+        received = httpd_req_recv(req, buf + cur_len, total_len - cur_len);
         if (received <= 0) {
+            free(buf);
             /* Respond with 500 Internal Server Error */
             httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "Failed to post control value");
             return ESP_OK;
@@ -677,6 +695,7 @@ static esp_err_t PATCH_update_settings(httpd_req_t * req)
     buf[total_len] = '\0';
 
     cJSON * root = cJSON_Parse(buf);
+    free(buf);
     if (root == NULL) {
         httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST, "Invalid JSON");
         return ESP_OK;
diff --git a/main/system.c b/main/system.c
index 63d4ad0..b3f8c80 100644
--- a/main/system.c
+++ b/main/system.c
@@ -32,12 +32,14 @@
 #include "utils.h"
 #include "self_test.h"
 #include "filesystem.h"
+#include "asic.h"
 
 static const char * TAG = "system";
 
 //local function prototypes
 static esp_err_t ensure_overheat_mode_config();
 static esp_err_t SYSTEM_init_virtual_peripherals(GlobalState * GLOBAL_STATE);
+static float system_expected_hashrate(const GlobalState * GLOBAL_STATE);
 
 void SYSTEM_init_system(GlobalState * GLOBAL_STATE)
 {
@@ -263,12 +265,34 @@ static esp_err_t SYSTEM_init_virtual_peripherals(GlobalState * GLOBAL_STATE)
     }
 
     GLOBAL_STATE->SYSTEM_MODULE.is_screen_active = false;
-    GLOBAL_STATE->POWER_MANAGEMENT_MODULE.actual_frequency = nvs_config_get_float(NVS_CONFIG_ASIC_FREQUENCY);
-    GLOBAL_STATE->POWER_MANAGEMENT_MODULE.core_voltage = nvs_config_get_u16(NVS_CONFIG_ASIC_VOLTAGE);
+    SYSTEM_sync_virtual_runtime_state(GLOBAL_STATE);
 
     return ESP_OK;
 }
 
+static float system_expected_hashrate(const GlobalState * GLOBAL_STATE)
+{
+    return GLOBAL_STATE->POWER_MANAGEMENT_MODULE.frequency_value
+        * GLOBAL_STATE->DEVICE_CONFIG.family.asic.small_core_count
+        * GLOBAL_STATE->DEVICE_CONFIG.family.asic_count
+        / 1000.0f;
+}
+
+void SYSTEM_sync_virtual_runtime_state(GlobalState * GLOBAL_STATE)
+{
+#ifdef CONFIG_BITAXE_VIRTUAL
+    uint16_t core_voltage = nvs_config_get_u16(NVS_CONFIG_ASIC_VOLTAGE);
+    float frequency = nvs_config_get_float(NVS_CONFIG_ASIC_FREQUENCY);
+
+    GLOBAL_STATE->POWER_MANAGEMENT_MODULE.frequency_value = frequency;
+    GLOBAL_STATE->POWER_MANAGEMENT_MODULE.expected_hashrate = system_expected_hashrate(GLOBAL_STATE);
+    VCORE_set_voltage(GLOBAL_STATE, (double)core_voltage / 1000.0);
+    ASIC_set_frequency(GLOBAL_STATE);
+#else
+    (void)GLOBAL_STATE;
+#endif
+}
+
 void SYSTEM_notify_accepted_share(GlobalState * GLOBAL_STATE)
 {
     SystemModule * module = &GLOBAL_STATE->SYSTEM_MODULE;
diff --git a/main/system.h b/main/system.h
index 57040ce..7825f4a 100644
--- a/main/system.h
+++ b/main/system.h
@@ -7,6 +7,7 @@
 void SYSTEM_init_system(GlobalState * GLOBAL_STATE);
 void SYSTEM_init_versions(GlobalState * GLOBAL_STATE);
 esp_err_t SYSTEM_init_peripherals(GlobalState * GLOBAL_STATE);
+void SYSTEM_sync_virtual_runtime_state(GlobalState * GLOBAL_STATE);
 
 void SYSTEM_notify_accepted_share(GlobalState * GLOBAL_STATE);
 void SYSTEM_notify_rejected_share(GlobalState * GLOBAL_STATE, char * error_msg);
